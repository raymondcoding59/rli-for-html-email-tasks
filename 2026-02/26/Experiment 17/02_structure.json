                    { "type": "text_link", "text": "View Web Version" },
                    { "type": "separator", "value": "•" },
                    { "type": "text_link", "text": "Email Preferences" },
                    { "type": "separator", "value": "•" },
                    { "type": "text_link", "text": "Unsubscribe" }
                  ]
                }
              },

              {
                "row_id": "row_8_billing_disclaimer",
                "background": "#ffffff",
                "structure": {
                  "type": "paragraph",
                  "text": "*Billed as one payment of $144.00 USD. Price shown in USD, regional prices may vary."
                }
              },

              {
                "row_id": "row_9_subscription_explanation",
                "background": "#ffffff",
                "structure": {
                  "type": "paragraph",
                  "text": "You received this offer for Grammarly Pro because you are currently opted in to receive them via your preference settings. You may adjust your preferences at any time by clicking the link above"
                }
              },

              {
                "row_id": "row_10_copyright",
                "background": "#ffffff",
                "structure": {
                  "type": "text",
                  "role": "small_print",
                  "text": "© 2026 Grammarly, Inc., 2261 Market Street, STE 85232, San Francisco, CA 94114"
                }
              }

            ]
          }
        ]
