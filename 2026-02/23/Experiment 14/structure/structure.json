            {
              "type": "table_column",
              "width": "50%",
              "elements": [
                {
                  "type": "button",
                  "id": "upgrade_button",
                  "text": "Upgrade to unlock",
                  "style": "secondary"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "table_row",
      "id": "row_3_webinar_section",
      "container": {
        "border": "1px solid",
        "background": "white"
