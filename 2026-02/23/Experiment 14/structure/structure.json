            {
              "type": "image",
              "id": "apollo_logo_header",
              "alt": "Apollo Logo"
            }
          ]
        },
        {
          "type": "table_column",
          "width": "50%",
          "align": "right",
          "elements": [
            {
              "type": "text_link",
              "id": "login_link",
              "text": "Log in"
            }
          ]
        }
      ]
    },
    {
      "type": "table_row",
      "id": "row_2_hero_section",
      "container": {
        "background": "light_gray",
        "border_radius": "8px"
      },
      "children": [
        {
          "type": "table_row",
          "id": "row_2_1_video_thumbnail",
