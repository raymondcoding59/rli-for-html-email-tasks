  "global_email_client_considerations": {
    "table_layout": "All rows structured using nested tables for maximum email client compatibility.",
    "container_alignment": "Centered using align=\"center\" and margin: 0 auto;",
    "image_rendering": "Use display:block; border:0; line-height:0; to prevent gaps in Outlook.",
    "responsive_behavior": "Max-width 600px container, hero image width:100%; height:auto;",
    "button_compatibility": "Bulletproof VML fallback recommended for Outlook.",
    "preheader_text": "None visible in design.",
    "border_collapse": "collapse",
    "body_margin_reset": "margin:0; padding:0;"
  }
